---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Route from "../components/Route.astro";
import People from "../components/People.astro";
import Footer from "../components/Footer.astro";
import { loadEventPage } from "../lib/event";

const page = await loadEventPage(import.meta.env.PUBLIC_EVENT_SLUG ?? "build-with-ai-2026");
const { event, stops } = page;
const cover = stops.at(-1)?.sessions.find((s) => s.coverImageUrl)?.coverImageUrl;
// Link previews get a copy of the cover published with the site, not the Storage original.
const ogImage = cover && new URL((await getImage({ src: cover, width: 1200, height: 300, format: "jpg" })).src, Astro.site).href;
---

<Layout title={`${event.name} ${event.edition} · GDG Cochabamba`} description={event.description} image={ogImage}>
  <header class="mx-auto flex max-w-6xl items-center justify-between px-5 pt-6 sm:px-8">
    <a href="https://gdg.com.bo" class="inline-flex items-center gap-3 font-bold">
      <img src="/gdg-icon.svg" alt="" class="h-7 w-auto" />
      GDG Cochabamba
    </a>
    <a href="https://build-with-ai-bol.web.app" class="text-sm font-medium text-link underline-offset-4 hover:underline">Edición 2025</a>
  </header>
  <main>
    <Hero event={event} stops={stops} totalAttendees={page.totalAttendees} sessionCount={page.sessionCount} />
    <Route stops={stops} organizers={page.organizers} venueName={event.venue?.name} />
    <People speakers={page.speakers} organizers={page.organizers} />
  </main>
  <Footer venue={event.venue} />
</Layout>
